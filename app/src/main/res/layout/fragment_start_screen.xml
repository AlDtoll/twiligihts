<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/skyImage"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginBottom="50dp"
        android:background="@drawable/night_sky_gradient"
        app:layout_constraintBottom_toBottomOf="@id/startAnimation"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/groundImage"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/night_ground_gradient"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/skyImage" />

    <ImageView
        android:id="@+id/grassImage"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/grass_gradient"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/skyImage" />

    <ImageView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginTop="25dp"
        android:src="@drawable/ic_flag"
        app:layout_constraintStart_toStartOf="@id/baseIcon"
        app:layout_constraintTop_toTopOf="@id/baseIcon" />

    <ImageView
        android:id="@+id/baseIcon"
        android:layout_width="180dp"
        android:layout_height="180dp"
        android:layout_marginStart="40dp"
        android:layout_marginBottom="35dp"
        android:src="@drawable/ic_castle"
        app:layout_constraintBottom_toBottomOf="@id/startAnimation"
        app:layout_constraintStart_toStartOf="parent" />

    <ImageView
        android:id="@+id/tentIcon"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_marginStart="@dimen/padding_16"
        android:layout_marginBottom="20dp"
        android:src="@drawable/ic_tent"
        app:layout_constraintBottom_toBottomOf="@id/startAnimation"
        app:layout_constraintStart_toStartOf="parent" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/startGameButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@color/light_green_background_color"
        android:enabled="false"
        android:foreground="?android:attr/selectableItemBackground"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:text="Start Game"
        android:textColor="?android:textColorPrimary"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/startAnimation"
        android:layout_width="200dp"
        android:layout_height="200dp"
        app:layout_constraintBottom_toTopOf="@id/logButton"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/startGameButton"
        app:lottie_autoPlay="true"
        app:lottie_enableMergePathsForKitKatAndAbove="true"
        app:lottie_fileName="bonfire.json"
        app:lottie_loop="true"
        app:lottie_repeatMode="restart" />

    <ImageView
        android:id="@+id/testIcon"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_margin="@dimen/padding_16"
        android:background="@drawable/ic_moon"
        android:padding="8dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/againIcon"
        android:layout_width="70dp"
        android:layout_height="70dp"
        android:layout_marginEnd="@dimen/padding_16"
        android:layout_marginBottom="20dp"
        android:src="@drawable/ic_grave"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/startAnimation"
        app:layout_constraintEnd_toEndOf="parent"
        tools:visibility="visible" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/logButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/padding_16"
        android:layout_marginTop="16dp"
        android:background="@color/light_green_background_color"
        android:foreground="?android:attr/selectableItemBackground"
        android:padding="@dimen/padding_16"
        android:text="Показать лог"
        android:textColor="@color/black"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@id/diceButton"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <ImageView
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_marginStart="4dp"
        android:rotation="-15"
        android:src="@drawable/ic_scull"
        app:layout_constraintStart_toEndOf="@id/diceButton"
        app:layout_constraintTop_toTopOf="@id/diceButton" />

    <ImageView
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_marginStart="30dp"
        android:layout_marginTop="100dp"
        android:src="@drawable/ic_grass"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/skyImage" />

    <ImageView
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="336dp"
        android:layout_marginTop="144dp"
        android:src="@drawable/ic_grass"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/skyImage" />

    <ImageView
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="64dp"
        android:layout_marginTop="164dp"
        android:src="@drawable/ic_grass"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/skyImage" />

    <ImageView
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginStart="68dp"
        android:layout_marginTop="48dp"
        android:src="@drawable/ic_grass"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/skyImage" />

    <ImageView
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginStart="340dp"
        android:layout_marginTop="72dp"
        android:src="@drawable/ic_grass"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/skyImage" />

    <ImageView
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_marginStart="336dp"
        android:layout_marginBottom="232dp"
        android:src="@drawable/ic_cloud"
        app:layout_constraintBottom_toBottomOf="@id/skyImage"
        app:layout_constraintStart_toStartOf="parent" />

    <ImageView
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_marginStart="64dp"
        android:layout_marginBottom="212dp"
        android:src="@drawable/ic_cloud"
        app:layout_constraintBottom_toBottomOf="@id/skyImage"
        app:layout_constraintStart_toStartOf="parent" />

    <ImageView
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginStart="364dp"
        android:layout_marginBottom="128dp"
        android:src="@drawable/ic_star"
        app:layout_constraintBottom_toBottomOf="@id/skyImage"
        app:layout_constraintStart_toStartOf="parent" />

    <ImageView
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginStart="264dp"
        android:layout_marginBottom="176dp"
        android:src="@drawable/ic_star"
        app:layout_constraintBottom_toBottomOf="@id/skyImage"
        app:layout_constraintStart_toStartOf="parent" />

    <ImageView
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginStart="112dp"
        android:layout_marginBottom="148dp"
        android:src="@drawable/ic_star"
        app:layout_constraintBottom_toBottomOf="@id/skyImage"
        app:layout_constraintStart_toStartOf="parent" />

    <ImageView
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginStart="276dp"
        android:layout_marginBottom="80dp"
        android:src="@drawable/ic_star"
        app:layout_constraintBottom_toBottomOf="@id/skyImage"
        app:layout_constraintStart_toStartOf="parent" />

    <ImageView
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:layout_marginStart="48dp"
        android:layout_marginBottom="204dp"
        android:src="@drawable/ic_star"
        app:layout_constraintBottom_toBottomOf="@id/skyImage"
        app:layout_constraintStart_toStartOf="parent" />

    <ImageView
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="212dp"
        android:layout_marginTop="104dp"
        android:src="@drawable/ic_grass"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/skyImage" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/diceButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/padding_16"
        android:layout_marginTop="16dp"
        android:background="@color/light_green_background_color"
        android:foreground="?android:attr/selectableItemBackground"
        android:padding="@dimen/padding_16"
        android:text="6"
        android:textColor="@color/black"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@id/editorButton"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/diceButton20"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/padding_16"
        android:layout_marginTop="16dp"
        android:background="@color/light_green_background_color"
        android:foreground="?android:attr/selectableItemBackground"
        android:padding="@dimen/padding_16"
        android:text="20"
        android:textColor="@color/black"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@id/editorButton"
        app:layout_constraintEnd_toEndOf="parent" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/diceButtonCustom"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/padding_16"
        android:layout_marginTop="16dp"
        android:background="@color/light_green_background_color"
        android:foreground="?android:attr/selectableItemBackground"
        android:padding="@dimen/padding_16"
        android:text="\?"
        android:textColor="@color/black"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@id/editorButton"
        app:layout_constraintStart_toStartOf="parent" />

    <ImageView
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="33dp"
        android:rotation="-15"
        android:src="@drawable/ic_fish"
        app:layout_constraintStart_toStartOf="@id/diceButtonCustom"
        app:layout_constraintTop_toBottomOf="@+id/diceButtonCustom" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/editorButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/padding_16"
        android:layout_marginTop="16dp"
        android:background="@color/light_green_background_color"
        android:foreground="?android:attr/selectableItemBackground"
        android:padding="@dimen/padding_16"
        android:text="Edit Game"
        android:textColor="@color/black"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <ImageView
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="@dimen/padding_16"
        android:layout_marginBottom="20dp"
        android:rotation="40"
        android:src="@drawable/ic_ribs"
        app:layout_constraintBottom_toBottomOf="@id/editorButton"
        app:layout_constraintStart_toEndOf="@id/editorButton" />

    <TextView
        android:id="@+id/version"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:text="1.21" />

</androidx.constraintlayout.widget.ConstraintLayout>